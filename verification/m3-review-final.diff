+  const phrase = latest[key] ?? extra[key] ?? dictionary[key] ?? m3Zh[key] ?? m2Zh[key] ?? fallback[key] ?? key;
   return phrase.replace(/\{(\w+)\}/g, (match, name: string) => String(vars[name] ?? match));
 }

