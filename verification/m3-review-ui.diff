+  'm3.emptyWeapon': ['空手', 'Empty hands'],
+  'm3.defaultSort': ['默认排序', 'Default order'], 'm3.orangeSort': ['橙品优先', 'Orange first'],
+  'm3.starChange': ['本局星数 {change} · 当前 {stars} 星', 'Stars {change} · Total {stars}'],
